int compare(const void *a, const void *b) {
    return (*(int*)a - *(int*)b);
}

int triangleNumber(int* nums, int numsSize) {
    qsort(nums, numsSize, sizeof(int), compare);
    int ans = 0;
    for (int k = 2; k < numsSize; k++) {
        int i = 0, j = k - 1;
        while (i < j) {
            if (nums[i] + nums[j] > nums[k]) {
                ans += j - i;
                j--;
            } else {
                i++;
            }
        }
    }
    return ans;
}
