#include <string.h>
#include <stdlib.h>

#define MIN(a, b) ((a) < (b) ? (a) : (b))

int minimumDeleteSum(char* s1, char* s2) 
{
    int m = strlen(s1);
    int n = strlen(s2);
    int* dp = (int*)malloc((n + 1) * sizeof(int));
    dp[0] = 0;
    for (int j = 1; j <= n; j++) 
    {
        dp[j] = dp[j - 1] + (int)s2[j - 1];
    }
    for (int i = 1; i <= m; i++)
    {
        int prev = dp[0];
        dp[0] += (int)s1[i - 1];    
        for (int j = 1; j <= n; j++) 
        {
            int temp = dp[j];
            if (s1[i - 1] == s2[j - 1]) 
            {
                dp[j] = prev;
            } 
            else 
            {
                dp[j] = MIN(dp[j] + (int)s1[i - 1], dp[j - 1] + (int)s2[j - 1]);
            }
            prev = temp;
        }
    }
    int result = dp[n];
    free(dp);
    return result;
}
