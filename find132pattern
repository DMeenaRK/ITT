#include <stdbool.h>
#include <stdlib.h>
#include <limits.h>

bool find132pattern(int* nums, int numsSize) {
    if (numsSize < 3) return false;
    
    int third = INT_MIN;
    
    int* stack = malloc(numsSize * sizeof(int));
    int top = -1;
    
    for (int i = numsSize - 1; i >= 0; i--) {
        if (nums[i] < third) {
            free(stack);
            return true;
        }
        
        while (top >= 0 && stack[top] < nums[i]) {
            third = stack[top];
            top--;
        }
        
        top++;
        stack[top] = nums[i];
    }
    
    free(stack);
    return false;
}
