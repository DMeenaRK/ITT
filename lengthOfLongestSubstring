#include <string.h>
#include <stdbool.h>
int max(int a, int b)
{
    return a > b ? a : b;
}
int lengthOfLongestSubstring(char* s)
{
    int n = strlen(s);
    if (n == 0) return 0;
    int res = 0;
    bool vis[128] = {false};
    int left = 0;
    for (int right = 0; right < n; right++)
     {
        while (vis[s[right]])
         {
            vis[s[left]] = false;
            left++;
        }
        vis[s[right]] = true;
        res = max(res, right - left + 1);
    }
    return res;
}
