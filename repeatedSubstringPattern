#include <stdbool.h>
#include <string.h>
#include <stdlib.h>

bool repeatedSubstringPattern(char* s) {
    int len = strlen(s);
    if (len <= 1) return false;
    
    char* doubled = malloc((len * 2 + 1) * sizeof(char));
    strcpy(doubled, s);
    strcat(doubled, s);
    
    doubled[len * 2 - 1] = '\0';
    char* shifted = doubled + 1;
    
    bool result = strstr(shifted, s) != NULL;
    
    free(doubled);
    return result;
}
